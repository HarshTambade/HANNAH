PORT=3001
# Loopback is safer for local use. Use 0.0.0.0 only when a trusted LAN device needs access.
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
# Required for all /api routes except /api/health. Generate with: openssl rand -hex 32
# Share this value with trusted app users out of band; never place it in a VITE_* variable.
HANNAH_API_TOKEN=
# Per-token fixed-window limits. The defaults are 30 chat, 60 agent, and 20
# desktop-computer requests per 60 seconds.
HANNAH_RATE_LIMIT_WINDOW_MS=60000
HANNAH_RATE_LIMIT_CHAT_MAX=30
HANNAH_RATE_LIMIT_AGENT_MAX=60
HANNAH_RATE_LIMIT_DESKTOP_MAX=20
# Optional remote MCP endpoint. Use HTTPS in production and generate a unique token
# with: openssl rand -hex 32. Keep the token in server/.env, never in a VITE_* value.
MCP_ENABLED=false
MCP_API_TOKEN=
# Base URL of HANNAH's REST API used by the MCP stdio process and MCP tools.
HANNAH_API_URL=http://127.0.0.1:3001
# Optional shared credential for server-side cloud clients (for example MCP).
# Browser visitors may enter their own Groq key; it is held in page memory only.
HANNAH_DEFAULT_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Optional keys enable the matching provider in the app's provider picker.
# Each provider uses its own *_MODEL and comma-separated *_MODELS values as defaults/fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
ANTHROPIC_DESKTOP_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GEMINI_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
TOGETHER_API_KEY=
TOGETHER_BASE_URL=
TOGETHER_MODEL=
TOGETHER_MODELS=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
CEREBRAS_MODEL=
CEREBRAS_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_MODEL=
MISTRAL_MODELS=
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=
XAI_MODELS=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
FIREWORKS_MODEL=
FIREWORKS_MODELS=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
NVIDIA_MODELS=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=
SAMBANOVA_MODEL=
SAMBANOVA_MODELS=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
PERPLEXITY_MODEL=
PERPLEXITY_MODELS=
HYPERBOLIC_API_KEY=
HYPERBOLIC_BASE_URL=
HYPERBOLIC_MODEL=
HYPERBOLIC_MODELS=
# Optional generic OpenAI-compatible endpoint (also accepts legacy CLOUD_API_URL/CLOUD_API_KEY).
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_MODELS=
# Per-model cloud request timeout. Connection failures skip the remaining cloud models.
CLOUD_REQUEST_TIMEOUT_MS=60000
# Optional daily spending cap (USD, estimated from list prices) per token or visitor key.
HANNAH_DAILY_BUDGET_USD=
# Optional providers to try, in order, when a hannah-auto request fails with a retryable error.
HANNAH_PROVIDER_FALLBACKS=
# Optional: use a different OpenAI-compatible provider instead of Groq.
# CLOUD_API_URL=https://your-provider.example/v1/chat/completions
# CLOUD_API_KEY=replace_with_your_cloud_provider_api_key
# CLOUD_MODEL_FALLBACKS=your-primary-model,your-fallback-model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Optional local OpenAI-compatible runtimes: configure a base URL and the model it serves.
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=
LLAMACPP_BASE_URL=
LLAMACPP_MODEL=
VLLM_BASE_URL=
VLLM_MODEL=
# Optional Mithi v1 Flash service URL; for mobile clients use a reachable HTTPS URL.
MITHI_TTS_URL=
# Optional native CallKit/Telecom voice calls. Point this at a trusted server-side
# endpoint that uses the Pinecall SDK/API key and returns { token, server }.
PINECALL_TOKEN_URL=
# --- Observability -----------------------------------------------------------
# Optional Sentry error tracking. Events are scrubbed of prompts, completions,
# API keys, Authorization headers, request bodies, and local file paths.
SENTRY_DSN=
# Set to false to keep a DSN configured but temporarily stop uploads.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Metadata-only LLM traces: provider/model, latency, token counts, and fallbacks.
# The JSONL log never contains prompt or completion text. Leave Langfuse keys
# blank to keep traces local-only.
LLM_TRACE_LOG=logs/llm_traces.jsonl
LLM_TRACING_DISABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
# Local agent health probe used by GET /api/health/agent.
PYTHON_FALLBACK_URL=http://127.0.0.1:8000
HEALTH_CHECK_TIMEOUT_MS=2500
# In-app feedback. Configure a Discord webhook and/or MongoDB; with neither,
# /api/feedback returns 503. Feedback is never logged and never stores an IP.
FEEDBACK_DISCORD_WEBHOOK_URL=
MONGODB_URI=
MONGODB_DB=hannah
MONGODB_FEEDBACK_COLLECTION=feedback
HANNAH_RATE_LIMIT_FEEDBACK_MAX=10
# Metadata-only AI content reports (message id + reason). The JSONL file never
# contains assistant text, IP addresses, or account identifiers.
CONTENT_REPORT_LOG=logs/content_reports.jsonl
HANNAH_RATE_LIMIT_CONTENT_REPORT_MAX=10
