PORT=3001
# Loopback is safer for local use. Use 0.0.0.0 only when a trusted LAN device needs access.
HOST=127.0.0.1
# Websites allowed to call this API from a browser (comma-separated), for example
# https://hannah.example.com. HANNAH's own apps (capacitor://localhost,
# https://localhost, http://localhost, capacitor-electron://localhost) are always
# allowed on top of this; set HANNAH_ALLOW_APP_ORIGINS=false to turn that off.
CLIENT_ORIGIN=http://localhost:5173
# Required for all /api routes except /api/health. Generate with: openssl rand -hex 32
# Share this value with trusted app users out of band; never place it in a VITE_* variable.
HANNAH_API_TOKEN=
# Per-token fixed-window limits. The defaults are 30 chat, 60 agent, and 20
# desktop-computer requests per 60 seconds.
HANNAH_RATE_LIMIT_WINDOW_MS=60000
HANNAH_RATE_LIMIT_CHAT_MAX=30
HANNAH_RATE_LIMIT_AGENT_MAX=60
HANNAH_RATE_LIMIT_DESKTOP_MAX=20
# Feedback, AI-reply reports and usage events are open to everyone using the app,
# so they're also limited per network address (per 15 minutes).
HANNAH_RATE_LIMIT_FEEDBACK_PER_ADDRESS=20
HANNAH_RATE_LIMIT_CONTENT_REPORT_PER_ADDRESS=30
HANNAH_RATE_LIMIT_EVENTS_PER_ADDRESS=300
# The visitor's address comes from X-Forwarded-For only when the connection is from
# this machine or a private network (a reverse proxy such as Caddy or nginx next to
# HANNAH). Set this to true if your proxy is elsewhere and always sets that header.
HANNAH_TRUST_PROXY=false
# Remote MCP endpoint at /mcp: on by default, for callers with their own credential
# (a developer key, the operator token, or a Groq key). Set MCP_ENABLED=false to turn it off.
# MCP_API_TOKEN is an optional extra token that acts as the operator: generate one
# with: openssl rand -hex 32. Keep it in server/.env, never in a VITE_* value.
MCP_ENABLED=true
MCP_API_TOKEN=
# Base URL of HANNAH's REST API used by the MCP stdio process and MCP tools.
HANNAH_API_URL=http://127.0.0.1:3001
# Optional shared credential for server-side cloud clients (for example MCP).
# Browser visitors may enter their own Groq key; it is held in page memory only.
HANNAH_DEFAULT_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Optional keys enable the matching provider in the app's provider picker.
# Each provider uses its own *_MODEL and comma-separated *_MODELS values as defaults/fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
ANTHROPIC_DESKTOP_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GEMINI_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
TOGETHER_API_KEY=
TOGETHER_BASE_URL=
TOGETHER_MODEL=
TOGETHER_MODELS=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
CEREBRAS_MODEL=
CEREBRAS_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_MODEL=
MISTRAL_MODELS=
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=
XAI_MODELS=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
FIREWORKS_MODEL=
FIREWORKS_MODELS=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
NVIDIA_MODELS=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=
SAMBANOVA_MODEL=
SAMBANOVA_MODELS=
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=
PERPLEXITY_MODEL=
PERPLEXITY_MODELS=
HYPERBOLIC_API_KEY=
HYPERBOLIC_BASE_URL=
HYPERBOLIC_MODEL=
HYPERBOLIC_MODELS=
# Optional generic OpenAI-compatible endpoint (also accepts legacy CLOUD_API_URL/CLOUD_API_KEY).
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_MODELS=
# Per-model cloud request timeout. Connection failures skip the remaining cloud models.
CLOUD_REQUEST_TIMEOUT_MS=60000
# Optional daily spending cap (USD, estimated from list prices) per token or visitor key.
HANNAH_DAILY_BUDGET_USD=
# Optional providers to try, in order, when a hannah-auto request fails with a retryable error.
HANNAH_PROVIDER_FALLBACKS=
# Optional: providers to treat as self-hosted in Private routing mode even on a public address
# (for example your own vLLM box: custom,vllm). Local runtimes and loopback/private IPs already count.
HANNAH_SELF_HOSTED_PROVIDERS=
# Optional: use a different OpenAI-compatible provider instead of Groq.
# CLOUD_API_URL=https://your-provider.example/v1/chat/completions
# CLOUD_API_KEY=replace_with_your_cloud_provider_api_key
# CLOUD_MODEL_FALLBACKS=your-primary-model,your-fallback-model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Optional local OpenAI-compatible runtimes: configure a base URL and the model it serves.
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=
LLAMACPP_BASE_URL=
LLAMACPP_MODEL=
VLLM_BASE_URL=
VLLM_MODEL=
# Optional Mithi v1 Flash service URL; for mobile clients use a reachable HTTPS URL.
MITHI_TTS_URL=
# Optional native CallKit/Telecom voice calls. Point this at a trusted server-side
# endpoint that uses the Pinecall SDK/API key and returns { token, server }.
PINECALL_TOKEN_URL=
# --- Observability -----------------------------------------------------------
# Optional Sentry error tracking. Events are scrubbed of prompts, completions,
# API keys, Authorization headers, request bodies, and local file paths.
SENTRY_DSN=
# Set to false to keep a DSN configured but temporarily stop uploads.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Metadata-only LLM traces: provider/model, latency, token counts, and fallbacks.
# The JSONL log never contains prompt or completion text. Leave Langfuse keys
# blank to keep traces local-only.
LLM_TRACE_LOG=logs/llm_traces.jsonl
LLM_TRACING_DISABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
# Local agent health probe used by GET /api/health/agent.
PYTHON_FALLBACK_URL=http://127.0.0.1:8000
HEALTH_CHECK_TIMEOUT_MS=2500
# In-app feedback. Configure a Discord webhook and/or MongoDB; with neither,
# /api/feedback returns 503. Feedback is never logged and never stores an IP.
FEEDBACK_DISCORD_WEBHOOK_URL=
MONGODB_URI=
MONGODB_DB=hannah
MONGODB_FEEDBACK_COLLECTION=feedback
HANNAH_RATE_LIMIT_FEEDBACK_MAX=10
# Metadata-only AI content reports (message id + reason). The JSONL file never
# contains assistant text, IP addresses, or account identifiers.
CONTENT_REPORT_LOG=logs/content_reports.jsonl
HANNAH_RATE_LIMIT_CONTENT_REPORT_MAX=10

# --- Accounts and sync (optional) --------------------------------------------
# Bring your own database. Any Postgres works: Supabase (Project Settings →
# Database → connection string; use the pooler URL on serverless hosts), Neon
# (pooled connection string), RDS, Cloud SQL, Azure, Railway, Render or your
# own server. SQLite (sqlite:./data/hannah.db) suits a single self-hosted
# server or desktop, not serverless. Tables are created automatically.
# On Vercel, connecting Supabase under Storage adds POSTGRES_URL, which HANNAH
# uses when DATABASE_URL is empty: nothing to copy.
DATABASE_URL=
# TLS: verified by default for remote hosts (Supabase against its own CA, which
# is built in). Use DATABASE_CA_CERT for another custom CA, or
# DATABASE_SSL=no-verify only if your provider requires it.
DATABASE_SSL=
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3
# Encrypts saved provider keys (envelope encryption). Generate: openssl rand -hex 32
# Keep it safe: losing it makes saved keys unreadable. Rotate by moving the old
# value into HANNAH_VAULT_PREVIOUS_KEYS.
# Without it, on Vercel with the Supabase integration, the key is derived from
# SUPABASE_JWT_SECRET (else SUPABASE_SECRET_KEY): nothing to set, but rotating
# that secret makes keys saved with it unreadable. Setting this takes over.
HANNAH_VAULT_KEY=
HANNAH_VAULT_PREVIOUS_KEYS=
# Set to false to stop new sign-ups.
HANNAH_ALLOW_SIGNUP=true
# true lets signed-in users use this server's provider keys (you pay for them).
# By default each user brings their own keys.
HANNAH_ACCOUNTS_USE_SERVER_KEYS=false

# ---- Workflows (docs/WORKFLOWS.md) ----
# Visual workflows need DATABASE_URL; credentials and HMAC webhook secrets need HANNAH_VAULT_KEY.
# A long-running server runs the workflow worker itself. On serverless hosting (Vercel), a cron
# must call GET /api/workflows/tick with "Authorization: Bearer <CRON_SECRET>" every few minutes.
CRON_SECRET=
# off: don't run the in-process worker (another process drives /api/workflows/tick).
WORKFLOW_WORKER=
WORKFLOW_USER_CONCURRENCY=3
WORKFLOW_WORKER_CONCURRENCY=4
WORKFLOW_DAILY_EXECUTIONS=500
# Self-hosting only: let workflow HTTP and database steps reach private network addresses.
WORKFLOW_ALLOW_PRIVATE_NETWORK=false
# Public origin used in webhook URLs when the server is behind a proxy (e.g. https://hannah.example.com).
HANNAH_PUBLIC_URL=

# --- Voice (optional) ----------------------------------------------------------
# Hosted voice engines use the same keys as chat (OPENAI_API_KEY for OpenAI
# voices, GROQ_API_KEY or the visitor's own Groq key for Whisper).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Outside MCP servers HANNAH can use as tools (optional, operator only) ----
# JSON list; https URLs (http only on localhost). Every call needs user approval.
# HANNAH_MCP_SERVERS=[{"id":"docs","name":"Team docs","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ..."}}]
HANNAH_MCP_SERVERS=

# --- Calendar and email (optional) ---------------------------------------------
# Lets signed-in users connect Google (Calendar, Gmail) or Microsoft (Outlook)
# with the provider's own sign-in. Needs DATABASE_URL and HANNAH_VAULT_KEY.
# Redirect URIs: <HANNAH_PUBLIC_URL>/api/account/connections/google/callback
# and .../microsoft/callback. Setup: docs/CALENDAR_AND_EMAIL.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (default), organizations, consumers, or a tenant ID
MICROSOFT_TENANT=

# --- A2A and sign-in redirects -----------------------------------------------------
# Public base URL for the agent card at /.well-known/agent-card.json and the
# calendar and email sign-in redirects (defaults to the request host).
HANNAH_PUBLIC_URL=

# Web search (server/web.js): Groq browser search model, with the request's own Groq key.
WEB_SEARCH_MODEL=openai/gpt-oss-20b
