# Optional Python fallback service configuration. The primary app is the
# React client + Express server; run Python only as a standby model-step service.
# This Groq-first router is used by that fallback and the optional Python Edition.
# Groq is tried in order, then secondary APIs, then configured local inference.
# Keep the requested Llama routes first; later entries cover accounts where a
# legacy model is unavailable. Provider model IDs can be changed per account.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional secondary providers. Each comma-separated model is tried in order.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash

# Local Python llama-cpp-python fallback (optional).
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_THREADS=4
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=

# API/runtime configuration.
HANNAH_HOST=127.0.0.1
HANNAH_PORT=8000
HANNAH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
HANNAH_WORKSPACE=.
APPROVAL_TTL_SECONDS=180
HANNAH_AUDIT_LOG=logs/hannah_audit.jsonl
HANNAH_PYTHON_SANDBOX_IMAGE=python:3.11-slim
HANNAH_NODE_SANDBOX_IMAGE=node:22-bookworm-slim
HANNAH_SHELL_SANDBOX_IMAGE=alpine:3.21
MITHI_TTS_URL=
MITHI_TTS_API_KEY=

# Python Edition frontend only. The primary client uses client/.env and Express.
# Never put provider keys in VITE_ variables.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_OFFLINE_MODEL_URL=

# eBPF is opt-in via `python ebpf/loader.py --enable-kernel-senses` and sends
# metadata only to a loopback API endpoint. BCC bindings are installed by OS.
HANNAH_SENSES_URL=http://127.0.0.1:8000/api/senses/events

# Optional Python fallback error tracking. Prompt and completion text, request
# bodies, identity, and local file paths are scrubbed before transmission.
SENTRY_DSN=
# Set to false to keep a DSN configured but temporarily stop uploads.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Metadata-only LLM traces shared with the Node runtime. The JSONL log never
# contains prompt or completion text. Leave Langfuse keys blank for local-only.
LLM_TRACE_LOG=logs/llm_traces.jsonl
LLM_TRACING_DISABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
