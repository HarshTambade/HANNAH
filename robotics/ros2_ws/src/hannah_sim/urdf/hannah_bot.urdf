<?xml version="1.0"?>
<!-- The fixed frames of hannah_bot, for robot_state_publisher. The odom → base_footprint transform comes from Gazebo. Written, not yet run. -->
<robot name="hannah_bot">
  <link name="base_footprint"/>
  <link name="base_link"><visual><geometry><cylinder radius="0.18" length="0.12"/></geometry></visual></link>
  <link name="lidar_link"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.09" rpy="0 0 0"/></joint>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.09" rpy="0 0 0"/></joint>
</robot>
