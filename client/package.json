{
  "name": "shanaya-companion-client",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyzer": "tsc -b && vite build --mode analyze",
    "bundle:size": "node scripts/check-bundle-size.mjs",
    "build:check-size": "npm run build && npm run bundle:size -- --strict",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync && npm run cap:patch:android && npm run cap:patch:ios",
    "cap:patch:android": "node scripts/patch-capacitor-gradle.mjs",
    "cap:patch:ios": "node scripts/patch-capacitor-ios.mjs",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:add:electron": "cap add @capawesome/capacitor-electron",
    "cap:sync:electron": "npm run build && cap sync @capawesome/capacitor-electron",
    "cap:run:electron": "npm run build && cap sync @capawesome/capacitor-electron && cap run @capawesome/capacitor-electron",
    "models:draco": "node scripts/compress-avatar.mjs",
    "cap:run:ios": "npm run build && cap sync ios && npm run cap:patch:ios && cap run ios",
    "cap:run:android": "npm run build && cap sync android && npm run cap:patch:android && cap run android",
    "test": "vitest run",
    "test:chaos": "vitest run src/__tests__/Phase25Chaos.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capawesome/capacitor-electron": "^0.2.2",
    "@capawesome/capacitor-live-update": "^8.8.1",
    "@capawesome/capacitor-torch": "^8.0.2",
    "@capgo/capacitor-permissions": "^8.2.8",
    "@capgo/capacitor-speech-synthesis": "^8.0.27",
    "@elizaos/capacitor-talkmode": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pinecall/ionic": "^0.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sentry/react": "^10.78.0",
    "@stomp/stompjs": "^7.5.0",
    "@xyflow/react": "^12.12.1",
    "capacitor-lancedb": "^0.2.2",
    "capacitor-mobile-claw": "^2.5.1",
    "capacitor-mobilecron": "^0.2.24",
    "capacitor-native-agent": "^0.9.16",
    "framer-motion": "^14.14.0",
    "llama-cpp-capacitor": "^0.1.5",
    "lucide-react": "^0.468.0",
    "posthog-js": "^1.450.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "use-browser-llm": "^0.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.4"
    }
  }
}
