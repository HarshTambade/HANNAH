{
  "format": 1,
  "id": "org.hannah.sim.thermometer",
  "version": "1.0.0",
  "name": "Simulated room sensor",
  "author": "HANNAH",
  "manufacturer": "HANNAH (simulated)",
  "model": "SIM-THERMO",
  "revisions": [
    "sim-1"
  ],
  "category": "sensor",
  "domain": "iot",
  "simulated": true,
  "protocol": {
    "adapter": "mqtt",
    "version": "3.1.1"
  },
  "connection": {
    "instructions": [
      "Start the simulator on the hub's computer: python3 -m hannah_edge simulate",
      "Use the address and port it prints."
    ],
    "fields": [
      {
        "id": "host",
        "label": "Broker address",
        "type": "text",
        "required": true,
        "help": "The computer on your network that runs the MQTT broker, for example 192.168.1.10."
      },
      {
        "id": "port",
        "label": "Port",
        "type": "number",
        "default": 1883,
        "min": 1,
        "max": 65535
      },
      {
        "id": "username",
        "label": "User name",
        "type": "text",
        "help": "Leave empty when the broker has none."
      },
      {
        "id": "password",
        "label": "Password",
        "type": "secret"
      },
      {
        "id": "tls",
        "label": "Encrypted (TLS)",
        "type": "toggle",
        "default": false
      }
    ]
  },
  "points": [
    {
      "id": "temperature",
      "name": "Temperature",
      "kind": "sensor",
      "type": "number",
      "unit": "°C",
      "range": [
        -20,
        60
      ],
      "access": "read",
      "binding": {
        "state": {
          "topic": "sim/thermo/reading",
          "json": "temperature"
        }
      }
    },
    {
      "id": "humidity",
      "name": "Humidity",
      "kind": "sensor",
      "type": "number",
      "unit": "%",
      "range": [
        0,
        100
      ],
      "access": "read",
      "binding": {
        "state": {
          "topic": "sim/thermo/reading",
          "json": "humidity"
        }
      }
    },
    {
      "id": "light",
      "name": "Light level",
      "kind": "sensor",
      "type": "number",
      "unit": "lx",
      "range": [
        0,
        100000
      ],
      "access": "read",
      "binding": {
        "state": {
          "topic": "sim/thermo/reading",
          "json": "lux"
        }
      }
    }
  ],
  "constraints": [],
  "permissions": [
    "network-local"
  ],
  "dependencies": [],
  "tests": {
    "level": "simulation",
    "passed": 0,
    "total": 0,
    "evidence": "hannah-os/runtime/tests/test_hub.py"
  },
  "documentation": "A simulated device for trying HANNAH without hardware. It is not a model of any product.",
  "availability": {
    "topic": "sim/thermo/status",
    "online": "online",
    "offline": "offline"
  }
}
