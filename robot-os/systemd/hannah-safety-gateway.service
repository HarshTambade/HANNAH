[Unit]
Description=HANNAH Robot OS Safety Gateway
After=network.target local-fs.target
Before=hannah-motor-controller.service hannah-ros2-runtime.service
Wants=local-fs.target

[Service]
Type=simple
User=hannah
Group=hannah
WorkingDirectory=/opt/hannah-robot-os
ExecStart=/usr/bin/python3 -m hannah_robot_os service safety-gateway --config /etc/hannah-robot-os/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hannah-robot-os /var/log/hannah-robot-os /run/hannah-robot-os

[Install]
WantedBy=multi-user.target
