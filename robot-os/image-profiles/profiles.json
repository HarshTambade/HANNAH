{
  "version": 1,
  "profiles": [
    {
      "id": "robotos-dev-x86_64",
      "name": "HANNAH Robot OS Developer (x86_64)",
      "arch": "amd64",
      "base": "debian-13",
      "target": "generic-x86_64",
      "services": [
        "hannah-safety-gateway",
        "hannah-hardware-manager",
        "hannah-motor-controller",
        "hannah-sensor-manager",
        "hannah-ros2-runtime",
        "hannah-telemetry",
        "hannah-update-manager"
      ],
      "packages": [
        "python3",
        "ca-certificates",
        "openssh-server",
        "nftables",
        "can-utils"
      ],
      "ros2": "jazzy",
      "status": "experimental",
      "image": {
        "tool": "mkosi",
        "board": "uefi",
        "arch": "x86-64",
        "kernel": "standard",
        "ci": "build-and-boot"
      },
      "note": "Built and boot-checked in QEMU by robot-os-image-ci.yml once CI runs it; never booted on hardware."
    },
