{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm install --include=dev --ignore-scripts",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "installCommand": "npm install"
    }
  },
  "headers": [
    {
      "source": "/models/wake/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/agent-card.json",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/download/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/s/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
